# 이 파일을 .env 로 복사해서 채움 (.env 는 git 에 안 올라감). 키를 git·메신저로 보내지 말 것.

# 답변·의도·코스 LLM (GPT-6 Luna)
OPENAI_API_KEY=
# 선택: LLM 추론 강도 (비우면 none)
LUNA_EFFORT=

# Titan 임베딩 (AWS Bedrock). EC2 에 Bedrock 권한 IAM 역할을 붙이면 키 두 개는 비움
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-northeast-2

# DB 비밀번호 (compose 가 db 컨테이너와 api 의 DATABASE_URL 에 같이 씀)
DB_PASSWORD=gbg

# 로컬에서 api 를 compose 없이 직접 띄울 때만 (uvicorn): 호스트에서 db 컨테이너로 접속
DATABASE_URL=postgresql://postgres:gbg@127.0.0.1:5433/gbg

# Redis (compose 가 api·realtime 에 redis://redis:6379/0 을 넣음. 로컬 직접 실행 때만)
REDIS_URL=redis://127.0.0.1:6379/0

# 운영자 API (/api/admin/*) 토큰. 비우면 관리자 API 꺼짐. 긴 임의 문자열로 (가이드 접근 코드와 다르게)
ADMIN_TOKEN=
# 개발용 도구 (/api/dev/live-tester: 라이브 투어 브라우저 테스트 페이지). 운영에서는 0
DEV_TOOLS=0

# 라이브 투어
# 가이드 세션 만들기 접근 코드 (비우면 검사 안 함 — 운영에서는 꼭 채움)
GUIDE_ACCESS_CODE=
# 관람객 참여 링크(QR)의 앞부분 = 앱 주소. 예: https://xxxx.cloudfront.net
PUBLIC_BASE_URL=http://localhost:5173
# 음성 인식 (STT 벤치마크 v2 4.3)
#   whisper_http = 1안 집 서버 Whisper (stt-server/) · transcribe = 2 대안 Amazon Transcribe · none = 끔(개발용)
STT_PROVIDER=none
# whisper_http: 집 서버 주소 (쉼표 = 앞에서부터 시도, 1안 Z6 G4 → 3안 Mac mini). 터널 주소를 씀
STT_HTTP_URLS=
STT_HTTP_TOKEN=
STT_HTTP_TIMEOUT=5
# 위치별 사전 JSON {"<poiId>": ["근정전", ...]} — 받아쓰기 사전(Whisper prompt)·Transcribe 위치별 어휘·후처리 사전에 같이 씀
# 운영: /srv/data/stt_hints.json (POI 71곳, gunggeum-ai-stt 위치별 사전을 scripts/convert_stt_hints.py 로 변환, 이미지에 들어 있음)
# 예시 2곳만 쓰려면 /srv/data/stt_hints.example.json
STT_HINTS_PATH=/srv/data/stt_hints.json
# 후처리 사전(자모 Jaro-Winkler 0.85): 비우면 transcribe 일 때만, 1/0 으로 강제
STT_POSTCORRECT=
# 자주 틀리는 표기 → 정답 표 JSON {"경위로": "경회루"} (위치 무관, 후처리 사전보다 먼저, STT_POSTCORRECT 가 꺼지면 안 씀). 비우면 api/data/stt_corrections.json
STT_CORRECTIONS_PATH=
# transcribe: 위치별 사용자 지정 어휘 이름 앞부분 (어휘 이름 = 앞부분 + poiId, ':' 는 '-'), 위치 모를 때 쓸 기본 어휘
# 팀 AWS 계정(서울)에 등록된 값 (2026-11-09 확인, READY): 위치별 gungeum-place-<poiId> 71개 + 공통 gungeum-gyeongbokgung-ko
# (STT_PROVIDER=transcribe 일 때만 씀. 새로 만들 때는 scripts/aws/setup_stt_vocab_and_terms.sh)
TRANSCRIBE_VOCABULARY_PREFIX=gungeum-
TRANSCRIBE_VOCABULARY=gungeum-gyeongbokgung-ko
# transcribe: 해설사 폰이 보내는 PCM 샘플레이트
AUDIO_SAMPLE_RATE=16000
# 번역: aws (Amazon Translate) | echo (개발용, 한국어 그대로)
TRANSLATE_PROVIDER=echo
# Translate Custom Terminology 이름 하나 (전각·용어 표기를 카드와 같게). api/data/translate_terms.csv 를 등록한 이름, 팀 기본 gungeum-ko
# (scripts/aws/setup_stt_vocab_and_terms.sh 로 등록). 없는 이름이면 용어집 없이 번역함
TRANSLATE_TERMINOLOGY=gungeum-ko
# 개발용: 해설사 WebSocket 에 {"type":"text","textKo":"..."} 로 문장을 직접 넣기 (운영에서는 0)
ALLOW_TEXT_INPUT=1

# 개발용 CORS 허용 출처 (쉼표 구분). 운영은 CloudFront 같은 도메인이라 비움
CORS_ORIGINS=http://localhost:5173

# Nginx 를 띄울 호스트 주소·포트. 기본은 이 PC 안에서만 (터널·로컬 브라우저). EC2 는 HTTP_BIND=0.0.0.0, HTTP_PORT=80
HTTP_BIND=127.0.0.1
HTTP_PORT=8080

# Cloudflare Tunnel 토큰 (온프레미스 개발 서버 공개용, docker compose --profile tunnel up -d)
CLOUDFLARE_TUNNEL_TOKEN=
